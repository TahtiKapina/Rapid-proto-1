  m_Script: {fileID: 11500000, guid: 58f7527abb33066469d474a32b6d48dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCQuestion
  question1: Looks
  question2: Eyes
  question3: Floating
  answer1: "c\u0335\u0312\u034B\u0302\u0307\u030B\u0360\u0342\u030B\u0342\u035B\u0344\u0332\u031F\u0322\u032C\u0349\u031D\u0316\u034D\u0348\u032Do\u0335\u034B\u030B\u030C\u0325\u033B\u0345\u032A\u033Cs\u0336\u0352\u0343\u031A\u0360\u033F\u0315\u0300\u034A\u030B\u0357\u0309\u0300\u0306\u035B\u0308\u0359\u0348\u0322\u034D\u0316\u0348\u0327\u0354m\u0338\u0360\u0313\u030C\u033D\u0304\u034A\u0302\u0308\u031B\u0342\u0313\u0344\u030B\u030D\u0357\u0319o\u0336\u0344\u0357\u033D\u033C\u034D\u0331\u035A\u0321\u0331\u0354\u0326s\u0335\u030C\u031B\u0307\u0358\u031B\u034A\u0314\u034A\u0303\u0340\u0305\u0302\u030F\u033C\u033A\u0317\u0321\u0318\u0353"
  answer2: "e\u0337\u0315\u034A\u0313\u0316\u033A\u033C\u034E\u0339\u035C\u035A\u032D\u032Ey\u0337\u0308\u0351\u0358\u035D\u0344\u0312\u0345\u0316\u0356\u032E\u0321\u032C\u0349\u0324\u0319\u0347\u0323e\u0338\u0304\u030C\u0306\u0307\u030A\u0311\u0314\u035D\u033E\u031A\u034C\u034A\u0309\u034D\u0359\u0339\u0359\u0348\u032C\u0355s\u0335\u0341\u0343\u0358\u031A\u031E\u032A\u0359\u0347\u0328\u032D\u034D\u032E\u0349\u034E\u0354\u033A\u0319\u031F
    \u0338\u031B\u0313\u0311\u0303\u033F\u033F\u0344\u0352\u0307\u030F\u0360\u030D\u0344\u034B\u0340\u0327\u0321\u0327\u0349\u0356\u0327\u0318\u034E\u0323\u034D\u0324\u0320\u0333\u035Co\u0336\u031B\u0357\u0303\u0303\u035D\u0306\u0308\u0344\u034A\u0305\u0309\u033F\u0308\u0333\u034E\u0339\u0354\u0326\u0330\u0354\u0325f\u0338\u0301\u030D\u034C\u0309\u0343\u0351\u0313\u030B\u032A\u0326\u0320\u035C\u0331
    \u0336\u0313\u035D\u0311\u0340\u0340\u032F\u0321\u0325\u0316\u0321\u031C\u0353\u0356\u034D\u0348\u0323\u031Fm\u0337\u0304\u035D\u030E\u0308\u030B\u0341\u034C\u0302\u030F\u0306\u0340\u0307\u0342\u0351\u035B\u0326\u0329\u0345\u0316\u0345\u0325\u0326\u035C\u0327\u034E\u031E\u033B\u0326\u034D\u0319i\u0335\u0342\u0352\u0341\u0309\u030E\u032E\u031D\u0331\u0359\u0316\u032A\u032F\u0345n\u0334\u0358\u0346\u032D\u032C\u032B\u032Ce\u0338\u0343\u0360\u0313\u0315\u035B\u034B\u033E\u0340\u0346\u0345\u0348
    \u0338\u0358\u0341\u0311\u0351\u0344\u0301\u030F\u0358\u0314\u030C\u0360\u0309\u032A\u0349\u0345\u0345\u0329\u0318s\u0338\u0341\u0344\u033F\u030C\u0312\u0311\u0357\u0352\u032F\u032E\u0328\u0353\u0327\u034Ee\u0336\u0309\u031B\u030B\u0300\u0341\u0360\u0312\u0340\u0307\u0308\u0306\u030E\u0341\u0344\u0329\u032D\u032F\u032E\u032D\u0329\u0333\u0327\u032E\u0359\u034D\u0332\u0327\u033A\u0319e\u0337\u0305\u031A\u035D\u0347\u0323\u0321\u0324\u0323\u032A\u0333\u032F\u0325\u032D\u0333\u0330\u033A
    \u0338\u030C\u0302\u0357\u0342\u0307\u033F\u035D\u035D\u030A\u0306\u035B\u0350\u0308\u0341\u0348\u0353\u034E\u0317\u032C\u033C\u0359\u0327\u033B\u0330\u031Ee\u0334\u0357\u035B\u0307\u0305\u035D\u0302\u0308\u030C\u0303\u033E\u0308\u031B\u0304\u0351\u0349\u035A\u035A\u0331\u031D\u0356\u031E\u0354v\u0334\u0310\u0309\u0303\u032F\u035C\u035Ce\u0334\u0306\u0307\u0300\u030B\u030D\u0343\u0311\u0343\u0352\u0301\u030D\u0345\u0318\u0324\u0333\u0349\u0326\u0332\u032D\u0326\u0329\u0329\u0349r\u0335\u035D\u034A\u030C\u0311\u030B\u0307\u034A\u0346\u030B\u0323\u035C\u0322\u032A\u0355\u035C\u0333\u0356\u0321\u0332\u0339\u0325\u032B\u0318\u0328y\u0337\u034B\u0313\u034D\u035C\u032D\u035A\u031F\u033B\u0330\u0349\u0347\u031C\u0333\u031E\u032F\u0359t\u0338\u0343\u034B\u031A\u0304\u0345\u032C\u033B\u0321\u031F\u035C\u0355h\u0335\u0304\u0350\u0313\u0300\u0303\u0309\u0318\u0319\u0318\u033C\u0323\u032F\u0330\u035C\u0324\u031Fi\u0334\u0351\u0308\u0342\u0305\u0344\u035D\u0314\u0360\u0341\u030D\u0302\u030B\u0340\u035D\u0319\u0330\u0326\u0356\u0327\u032F\u032An\u0334\u0358\u0314\u030A\u035D\u0342\u0351\u032A\u033B\u0331\u032D\u035A\u031F\u0319\u0339\u0355\u0325\u032C\u031Dg\u0334\u0358\u0306\u0314\u0346\u0303\u0314\u0346\u035D\u0357\u0350\u0304\u0357\u034A\u0316\u0347\u0316\u0322\u0327\u034E\u0328\u034D\u0331\u0347\u035C\u0325"
  answer3: "a\u0334\u0343\u0303\u033F\u0340\u033D\u0333\u0328\u0359 \u0335\u0307\u035B\u034A\u030C\u035B\u0344\u035B\u030E\u0311\u030D\u0341\u0311\u034D\u0326\u0347\u032A\u031C\u0330c\u0338\u0360\u035B\u030B\u0342\u0310\u0303\u0302\u031B\u035B\u0310\u031A\u0307\u0306\u031B\u034B\u0330\u0328\u0349\u031D\u0328\u0349\u033B\u035A\u0323\u0332\u0347\u0321h\u0336\u030C\u0341\u035D\u033A\u031F\u0347\u0354\u0323\u0319\u0329i\u0338\u0300\u030E\u0308\u030C\u0343\u0360\u0316\u033B\u0320\u032A\u0359l\u0338\u030D\u0312\u0300\u0310\u0301\u0314\u034C\u0315\u030B\u0352\u0343\u0343\u0300\u034C\u0301\u0317\u0355\u0347\u031F\u0345d\u0338\u030F\u0357\u030E\u0324\u0353\u0319\u035A\u0326\u0328\u033B\u0331\u0317\u0324\u0339\u032F\u0325
    \u0337\u0340\u0313\u0300\u0316\u0349\u034E\u0353\u035C\u031Eo\u0338\u033F\u0357\u034A\u0314\u034A\u0346\u0303\u030D\u030E\u0343\u0350\u033A\u031C\u0349\u0345\u035A\u035C\u035Cf\u0336\u0342\u0360\u034C\u030B\u0353\u033C\u033B\u0354
    \u0337\u0351\u0300\u030B\u0313\u033F\u0310\u034B\u031B\u0304\u0315\u031A\u0343\u0304\u0343\u032A\u0333\u0353\u0320\u0326\u032A\u0353\u032F\u034E\u031E\u0320\u035A\u0321\u0339c\u0335\u0358\u0316\u0331\u031Eo\u0334\u0346\u0346\u0306\u0303\u030B\u0301\u0313\u0347\u0327\u032F\u0329\u031C\u0327\u0353\u0321\u0320\u0332\u0325s\u0337\u035D\u0305\u031E\u0318\u0331\u0333\u0330m\u0338\u034A\u0307\u033A\u0349\u0327\u032F\u0327\u0345\u031D\u0319\u0345\u032Bo\u0334\u034A\u031B\u035D\u0309\u0312\u0308\u035D\u0351\u034A\u0343\u0303\u0302\u0329\u0325\u0326\u034Ds\u0336\u033D\u0302\u030E\u033D\u030C\u0307\u0340\u033F\u0347\u032F\u0321\u0318\u031F\u032D\u0323\u0319\u033B\u0339\u0359\u0317\u0348
    \u0334\u030F\u031A\u034C\u0358\u0301\u030C\u0314\u0300\u030A\u0307\u0344\u0352\u0302\u030E\u0356\u033B\u0323\u031D\u032B\u032B\u0353\u0330\u033A\u0327n\u0334\u0350\u0340\u0314\u030F\u030A\u0344\u0330\u032F\u0356e\u0335\u0357\u0305\u0352\u0325\u032F\u0316\u0324\u032D\u0319\u0345e\u0338\u031B\u0325\u0330\u033C\u0333\u0325\u0359\u033Bd\u0338\u035D\u030B\u0301\u0301\u0312\u030A\u031A\u0347\u031F\u0328s\u0337\u030F\u0300\u0313\u033D\u035D\u0358\u0308\u0341\u0350\u033F\u0341\u0360\u030F\u0310\u0346\u031D\u0353\u033B
    \u0335\u0306\u030D\u0344\u0303\u0352\u0305\u030A\u033C\u0325\u0327\u033A\u0359\u0323\u031C\u033Cn\u0336\u035D\u0350\u035D\u032C\u0318o\u0338\u0311\u0315\u0344\u0305\u0358\u0312\u0315\u0311\u0343\u0304\u0342\u030D\u034A\u0316t\u0337\u0301\u0350\u0300\u034A\u0344\u0304\u0312\u0340\u030B\u0352\u0310\u0344\u0350\u0331\u0354\u0326\u031F\u0327\u0355\u032E\u0333\u0325\u0354\u0328\u0326
    \u0336\u0344\u034C\u033F\u0301\u035B\u0344\u0307\u0316\u031C\u033C\u0320\u0321\u0321\u034D\u0327\u032F\u0348\u035C\u031E\u0359\u033Cw\u0335\u0357\u0346\u031B\u0340\u0309\u033E\u0346\u0302\u034A\u0310\u0344\u035D\u0346\u0358\u0313\u0348\u0345\u0326\u033A\u034E\u034D\u0339\u032C\u0318a\u0335\u030B\u035B\u0360\u030E\u0342\u0343\u0308\u030D\u034C\u0304\u0354\u0316\u0321\u035A\u0322\u0319\u0323\u0328l\u0336\u030D\u0309\u0340\u0311\u0351\u033D\u0304\u030B\u033F\u0350\u0344\u0344\u0307\u035A\u0354\u034E\u0327\u035C\u0316\u0348\u0359\u0317\u0329\u0318\u0348k\u0337\u0340\u0308\u033D\u034A\u0304\u0344\u0351\u0351\u0352\u0310\u0308\u035D\u031D"
